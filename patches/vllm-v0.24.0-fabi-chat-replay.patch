@@ -241,0 +242,14 @@ pub struct ChatCompletionRequest {
+/// Private token-exact replay envelope used by distributed frontends after a
+/// route loss. The nested request remains an ordinary validated chat request.
+#[derive(Debug, Clone, Deserialize, Serialize, Validate)]
+pub struct ChatReplayRequest {
+    #[validate(nested)]
+    pub request: ChatCompletionRequest,
+    #[validate(length(min = 1, max = 262144))]
+    pub original_prompt_token_ids: Vec<u32>,
+    #[validate(length(max = 262144))]
+    pub committed_output_token_ids: Vec<u32>,
+}
+
+impl Normalizable for ChatReplayRequest {}
+
