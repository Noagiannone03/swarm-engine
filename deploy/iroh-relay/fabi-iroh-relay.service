[Unit]
Description=Fabi authenticated Iroh relay
Documentation=https://github.com/n0-computer/iroh/tree/main/iroh-relay
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/fabi-iroh-relay/relay.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/iroh-relay --config-path=/etc/fabi-iroh-relay/config.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=1048576

NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/docker/volumes/edge-proxy_caddy_data/_data/caddy/certificates
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
