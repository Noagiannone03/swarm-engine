@@ -32 +32 @@ use crate::routes::openai::chat_completions::types::{
-    ChatMessageDelta,
+    ChatMessageDelta, ChatReplayRequest,
@@ -108,0 +109,74 @@ pub async fn chat_completions(
+/// Rebuild one interrupted chat stream from its exact committed token prefix.
+///
+/// This endpoint deliberately keeps the ordinary vLLM chat renderer, decoder,
+/// reasoning parser, and tool parser in the loop. It is intended for an
+/// authenticated local distributed-worker proxy, not direct OpenAI clients.
+pub async fn chat_replay(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    ValidatedJson(body): ValidatedJson<ChatReplayRequest>,
+) -> Response {
+    let ChatReplayRequest {
+        mut request,
+        original_prompt_token_ids,
+        committed_output_token_ids,
+    } = body;
+    if !request.stream {
+        return ApiError::InvalidRequest {
+            message: "chat replay requires stream=true".to_string(),
+            param: Some("stream"),
+        }
+        .into_response();
+    }
+
+    // Token IDs and reasoning are required internally to find the exact replay
+    // boundary. The distributed scheduler strips either field according to the
+    // original client request before forwarding future events.
+    request.return_token_ids = Some(true);
+    request.include_reasoning = true;
+    request.echo = false;
+
+    let request_context = resolve_request_context(&headers, request.request_id.as_deref());
+    let lora_resolution = state.resolve_model_with_loras(Some(&request.model)).await;
+    let prepared = match prepare_chat_request(request, &lora_resolution, request_context) {
+        Ok(prepared) => prepared,
+        Err(error) => return error.into_response(),
+    };
+    let request_span = tracing::info_span!(
+        "chat_replay",
+        request_id = %prepared.request_id,
+        engine_request_id = tracing::field::Empty,
+        committed_output_tokens = committed_output_token_ids.len(),
+    );
+    let created = unix_timestamp();
+    let api_server_options = state.api_server_options;
+
+    let chat_stream = match state
+        .chat
+        .chat_replay(
+            prepared.chat_request,
+            original_prompt_token_ids,
+            committed_output_token_ids,
+        )
+        .instrument(request_span.clone())
+        .await
+    {
+        Ok(stream) => stream,
+        Err(error) => {
+            return chat_submit_error("failed to submit chat replay request", error)
+                .into_response();
+        }
+    };
+
+    let chunk_stream = chat_completion_chunk_stream(
+        chat_stream,
+        prepared.request_id,
+        prepared.response_model,
+        created,
+        api_server_options,
+        prepared.options,
+    );
+    let sse_stream = chat_completion_sse_stream(chunk_stream).instrument(request_span);
+    Sse::new(sse_stream).into_response()
+}
+
