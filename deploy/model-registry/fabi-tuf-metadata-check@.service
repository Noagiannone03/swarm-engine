[Unit]
Description=Authenticate and check Fabi TUF metadata expiry for authority %i
Documentation=https://theupdateframework.github.io/specification/latest/
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/fabi-tuf-timestamp/%i/refresh.env
ExecCondition=/usr/bin/test -d ${FABI_TUF_REPOSITORY}/metadata
ExecCondition=/usr/bin/test -r ${FABI_TUF_BOOTSTRAP_ROOT}
ExecStart=/usr/bin/docker run --rm --name fabi-tuf-metadata-check-%i --network=none --read-only --cap-drop=ALL --security-opt=no-new-privileges --mount type=bind,source=${FABI_TUF_REPOSITORY},target=/registry,readonly --mount type=bind,source=${FABI_TUF_BOOTSTRAP_ROOT},target=/bootstrap-root.json,readonly --entrypoint /usr/local/bin/fabi-swarm-registry ${FABI_TUF_OPERATOR_IMAGE} inspect-metadata --repository-dir /registry --bootstrap-root /bootstrap-root.json --offline-warning-hours 72 --timestamp-warning-hours 8
TimeoutStartSec=5min
UMask=0022

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
