+use futures::{StreamExt, TryStreamExt as _, stream as futures_stream};
@@ -54 +56 @@ use vllm_engine_core_client::protocol::ModelDtype;
-use vllm_llm::Llm;
+use vllm_llm::{GenerateOutput, GeneratePromptInfo, Llm};
@@ -210,0 +213,105 @@ impl ChatLlm {
+    /// Rebuild a lost chat generation from exact committed token IDs.
+    ///
+    /// The replacement engine receives `original prompt || committed output`
+    /// as its prefill prompt, which reconstructs the attention cache without
+    /// sampling the already-visible prefix again. The committed output is also
+    /// injected once into the ordinary text decoder and chat output processor,
+    /// restoring incremental reasoning and tool-parser state. Callers must
+    /// suppress those replayed events and expose only events after the exact
+    /// committed-token boundary.
+    pub async fn chat_replay(
+        &self,
+        mut request: ChatRequest,
+        expected_prompt_token_ids: Vec<u32>,
+        committed_output_token_ids: Vec<u32>,
+    ) -> Result<ChatEventStream> {
+        request.validate()?;
+
+        let output_processor = self.backend.new_chat_output_processor(
+            &mut request,
+            NewChatOutputProcessorOptions {
+                tool_call_parser: &self.tool_call_parser,
+                reasoning_parser: &self.reasoning_parser,
+            },
+        )?;
+        let rendered = self.backend.chat_renderer().render(&request)?;
+        let (prompt, mm_features) = multimodal::finalize_rendered_prompt(
+            &request,
+            rendered,
+            self.backend.multimodal_model_info(),
+            self.model_dtype,
+        )
+        .await?;
+
+        let tokenizer = self.text.tokenizer();
+        let prompt_token_ids = match prompt {
+            Prompt::Text(text) => tokenizer.encode(&text, request.add_special_tokens)?,
+            Prompt::TokenIds(ids) => ids,
+        };
+        if prompt_token_ids != expected_prompt_token_ids {
+            return Err(Error::ReplayPromptMismatch {
+                expected_len: expected_prompt_token_ids.len(),
+                actual_len: prompt_token_ids.len(),
+                first_mismatch: prompt_token_ids
+                    .iter()
+                    .zip(&expected_prompt_token_ids)
+                    .position(|(actual, expected)| actual != expected)
+                    .unwrap_or(prompt_token_ids.len().min(expected_prompt_token_ids.len())),
+            });
+        }
+
+        let mut replay_prompt_token_ids =
+            Vec::with_capacity(prompt_token_ids.len() + committed_output_token_ids.len());
+        replay_prompt_token_ids.extend_from_slice(&prompt_token_ids);
+        replay_prompt_token_ids.extend_from_slice(&committed_output_token_ids);
+
+        let text_request = TextRequest {
+            request_id: request.request_id.clone(),
+            prompt: Prompt::TokenIds(replay_prompt_token_ids),
+            mm_features,
+            sampling_params: request.sampling_params,
+            decode_options: request.decode_options.clone(),
+            intermediate: request.intermediate,
+            priority: request.priority,
+            cache_salt: request.cache_salt,
+            add_special_tokens: false,
+            data_parallel_rank: request.data_parallel_rank,
+            lora_request: request.lora_request,
+        };
+        let raw_stream = self.text.generate_raw(text_request).await?;
+        let replay_output = GenerateOutput {
+            request_id: request.request_id.clone(),
+            prompt_info: Some(GeneratePromptInfo {
+                prompt_token_ids: Arc::from(prompt_token_ids),
+                prompt_logprobs: None,
+            }),
+            token_ids: committed_output_token_ids,
+            logprobs: None,
+            finish_reason: None,
+            cached_token_count: 0,
+            kv_transfer_params: None,
+        };
+        let future_stream = raw_stream.map(|next| {
+            next.map(|mut output| {
+                // The engine saw the extended replay prompt. Northbound
+                // decoders must instead keep the original chat prompt emitted
+                // by the synthetic replay output above.
+                output.prompt_info = None;
+                output
+            })
+        });
+        let replay_stream = futures_stream::iter([Ok(replay_output)]).chain(future_stream);
+        let decoded_stream = vllm_text::output::decoded_text_event_stream(
+            request.request_id.clone(),
+            tokenizer,
+            replay_stream,
+            request.decode_options,
+            request.intermediate,
+        )
+        .map_err(Error::from)
+        .boxed();
+        let structured_stream = output_processor.process(decoded_stream)?;
+
+        Ok(ChatEventStream::new(request.request_id, structured_stream))
+    }
+
