+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[serial]
+async fn chat_replay_prefills_exact_prefix_and_restores_chat_stream_state() {
+    let ipc = IpcNamespace::new().expect("create ipc namespace");
+    let handshake_address = ipc.handshake_endpoint();
+    let engine_id = b"engine-chat-replay".to_vec();
+    let original_prompt_token_ids =
+        b"user: hello\nassistant:".iter().copied().map(u32::from).collect::<Vec<_>>();
+    let committed_output_token_ids = vec![b'h' as u32, b'i' as u32];
+    let mut expected_engine_prompt = original_prompt_token_ids.clone();
+    expected_engine_prompt.extend_from_slice(&committed_output_token_ids);
+
+    let engine_task = MockEngineTask::new(spawn_mock_engine_task(
+        handshake_address.clone(),
+        engine_id.clone(),
+        move |dealer, push| {
+            boxed_test_future(async move {
+                let add = recv_engine_message(dealer).await;
+                let request: EngineCoreRequest =
+                    rmp_serde::from_slice(&add[1]).expect("decode request");
+                assert_eq!(
+                    request.prompt_token_ids.as_deref(),
+                    Some(expected_engine_prompt.as_slice())
+                );
+                assert_eq!(
+                    request.external_req_id.as_deref(),
+                    Some("chatcmpl-replay-req")
+                );
+
+                send_outputs(
+                    push,
+                    engine_outputs_for_request(
+                        &request.request_id,
+                        vec![(vec![b'!' as u32], Some(EngineCoreFinishReason::Length))],
+                    ),
+                )
+                .await;
+            })
+        },
+    ));
+
+    let client = EngineCoreClient::connect(
+        EngineCoreClientConfig::new_single(handshake_address)
+            .with_model_name("test-model")
+            .with_local_input_output_addresses(
+                Some(ipc.input_endpoint()),
+                Some(ipc.output_endpoint()),
+            ),
+    )
+    .await
+    .expect("connect client");
+    let chat = ChatLlm::from_shared_backend(test_llm(client), Arc::new(FakeChatBackend::new()));
+    let mut app = build_router(Arc::new(AppState::new(
+        vec!["Qwen/Qwen1.5-0.5B-Chat".to_string()],
+        chat,
+    )));
+
+    let response = app
+        .call(
+            Request::builder()
+                .method("POST")
+                .uri("/inference/v1/chat-replay")
+                .header("content-type", "application/json")
+                .body(Body::from(
+                    json!({
+                        "request": {
+                            "model": "Qwen/Qwen1.5-0.5B-Chat",
+                            "request_id": "replay-req",
+                            "stream": true,
+                            "messages": [{"role": "user", "content": "hello"}],
+                            "temperature": 0,
+                            "max_completion_tokens": 1
+                        },
+                        "original_prompt_token_ids": original_prompt_token_ids,
+                        "committed_output_token_ids": committed_output_token_ids
+                    })
+                    .to_string(),
+                ))
+                .expect("build request"),
+        )
+        .await
+        .expect("call app");
+
+    assert_eq!(response.status(), StatusCode::OK);
+    let body = to_bytes(response.into_body(), usize::MAX).await.expect("read body");
+    engine_task.await.expect("mock engine task");
+    let text = String::from_utf8(body.to_vec()).expect("utf8 body");
+    let payloads = sse_data_payloads(&text);
+    assert_eq!(payloads.len(), 5, "{text}");
+
+    let start: serde_json::Value = serde_json::from_str(payloads[0]).expect("start chunk");
+    assert_eq!(
+        start["prompt_token_ids"],
+        json!(b"user: hello\nassistant:".iter().copied().map(u32::from).collect::<Vec<_>>())
+    );
+    let replay: serde_json::Value = serde_json::from_str(payloads[1]).expect("replay chunk");
+    assert_eq!(replay["choices"][0]["delta"]["content"], "hi");
+    assert_eq!(
+        replay["choices"][0]["token_ids"],
+        json!([b'h' as u32, b'i' as u32])
+    );
+    let future: serde_json::Value = serde_json::from_str(payloads[2]).expect("future chunk");
+    assert_eq!(future["choices"][0]["delta"]["content"], "!");
+    assert_eq!(future["choices"][0]["token_ids"], json!([b'!' as u32]));
+    let terminal: serde_json::Value = serde_json::from_str(payloads[3]).expect("terminal chunk");
+    assert_eq!(terminal["choices"][0]["finish_reason"], "length");
