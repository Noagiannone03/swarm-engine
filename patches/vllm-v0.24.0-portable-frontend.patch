+        r#"{"model_tag":"Qwen/Qwen3-0.6B"}"#,
+    ])
+    .unwrap();
+
+    let Command::Frontend(args) = cli.command else {
+        panic!("expected frontend args");
+    };
+    let config = args.into_config();
+    assert_eq!(
+        config.listener_mode,
+        HttpListenerMode::BindTcp {
+            host: "127.0.0.1".to_string(),
+            port: 19080,
+        }
+    );
